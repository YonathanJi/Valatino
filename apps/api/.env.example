# ============================================================
# Variables de entorno — apps/api (NestJS)
# Copiar a .env para desarrollo local
# NUNCA exponer estas variables al cliente
# ============================================================

# Servidor
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# (No hace falta SUPABASE_JWT_SECRET: los tokens se verifican contra el JWKS
#  del proyecto, la API no firma ninguno.)

# Stripe (clave SECRETA — solo servidor)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (credenciales secretas — solo servidor)
PAYPAL_CLIENT_ID=<paypal-client-id>
PAYPAL_CLIENT_SECRET=<paypal-client-secret>
PAYPAL_WEBHOOK_ID=<paypal-webhook-id>
PAYPAL_ENVIRONMENT=sandbox

# CORS
CORS_ORIGIN=http://localhost:3000
# Opcional: habilita las preview URLs de Vercel DE ESTE proyecto indicando su
# prefijo (p.ej. "valatino" permite https://valatino-<hash>.vercel.app).
# Sin esta variable solo se aceptan los origenes exactos de CORS_ORIGIN.
# CORS_VERCEL_PREVIEW_PREFIX=valatino

# SMTP (email transaccional — mismo SMTP configurable en Supabase Auth para OTP)
# SendGrid: host smtp.sendgrid.net, user literal "apikey", pass = API key (SG....)
# EMAIL_FROM debe coincidir con el remitente verificado en el proveedor
#
# PUERTO 2525: Render (plan free) bloquea la salida por 465 y 587. Con esos
# puertos el envío se queda colgado hasta el timeout y el correo no sale nunca.
# En 2525 la conexión se cifra con STARTTLS (la API lo exige, no es opcional).
# Sin SMTP_HOST/SMTP_USER/SMTP_PASS la API arranca igual pero NO envía correos:
# lo deja anotado con un warning en el log.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASS=SG....
EMAIL_FROM=Valatino <noreply@valatino.es>
#
# Buzon al que van las RESPUESTAS del cliente, si es distinto del remitente.
# El From tiene que ser del dominio propio para que el proveedor lo firme con
# DKIM y el correo pase la alineacion DMARC; pero si ese dominio todavia NO
# tiene registros MX, ese buzon no recibe nada y quien responda a la
# confirmacion de su pedido se lleva un rebote. Con Reply-To el correo sale
# autenticado y la respuesta llega a alguien. Se quita cuando el dominio tenga
# buzon propio (entonces From y Reply-To coinciden).
# EMAIL_REPLY_TO=respuestas@ejemplo.com
